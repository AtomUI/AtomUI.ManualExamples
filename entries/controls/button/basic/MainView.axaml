<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             FontFamily="fonts:AlibabaSans#Alibaba Sans, $Default"
             x:Class="AtomUI.ManualExamples.Controls.Button.Basic.MainView">
  <Border Padding="40"
          Background="{atom:SharedTokenResource ColorBgContainer}">
    <WrapPanel HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Orientation="Horizontal">
      <WrapPanel.Styles>
        <Style Selector="atom|Button">
          <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
      </WrapPanel.Styles>

      <atom:Button ButtonType="Primary"
                   Content="Primary Button" />
      <atom:Button Content="Default Button" />
      <atom:Button ButtonType="Dashed"
                   Content="Dashed" />
      <atom:Button ButtonType="Text"
                   Content="Text Button" />
      <atom:Button ButtonType="Link" Content="Link Button" />
    </WrapPanel>
  </Border>
</UserControl>
